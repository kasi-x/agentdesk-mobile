# Copy to .dev.vars (git-ignored).
# Production: wrangler secret put AGENT_TOKEN / wrangler secret put CLIENT_TOKEN
AGENT_TOKEN=dev-agent-token
CLIENT_TOKEN=dev-client-token
# Optional CORS allowlist (comma-separated origins, "*" allows any)
# ALLOWED_ORIGINS=http://localhost:3000
# Optional undo grace window in ms (I-104, default 5000)
# UNDO_GRACE_MS=5000
# Optional Web Push / VAPID (I-701). When unset the hub skips push
# delivery silently. Generate a P-256 pair and set all three; the public
# key is base64url uncompressed (65 bytes), the private key the
# base64url of a JWK (or of the raw 32-byte scalar).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@localhost
# Optional native push via APNs (I-701 follow-up). Registration stores
# even when unset; delivery skips silently. APNS_PRIVATE_KEY is the .p8
# P-256 key (PEM or base64/DER). APNS_SANDBOX=1 for development builds.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=
# APNS_SANDBOX=
# Optional native push via FCM v1 (I-701 follow-up, Android-later).
# Same skip-when-unset pattern. FCM_PRIVATE_KEY is the service-account
# RSA key (PEM or base64/DER; literal "\n" escapes are tolerated).
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
